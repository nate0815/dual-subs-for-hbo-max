{
  "manifest_version": 3,
  "name": "HBO Max 雙字幕（自用）",
  "version": "0.1.0",
  "description": "在 HBO Max 播放頁同時顯示官方英文 CC 與繁體中文字幕。個人使用。",
  "minimum_chrome_version": "111",
  "content_scripts": [
    {
      "matches": ["https://www.hbomax.com/*"],
      "js": [
        "src/lib/vtt.js",
        "src/lib/mpd.js",
        "src/lib/overlay.js",
        "src/lib/langmenu.js",
        "src/main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
