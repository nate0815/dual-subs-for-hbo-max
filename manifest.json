{
  "manifest_version": 3,
  "name": "雙字幕 for HBO Max（非官方）",
  "version": "0.1.0",
  "description": "在 HBO Max 播放頁同時顯示兩條官方字幕。非官方工具，與 HBO 無關",
  "minimum_chrome_version": "111",
  "content_scripts": [
    {
      "matches": ["https://www.hbomax.com/*"],
      "js": [
        "src/lib/vtt.js",
        "src/lib/mpd.js",
        "src/lib/overlay.js",
        "src/lib/langmenu.js",
        "src/main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
